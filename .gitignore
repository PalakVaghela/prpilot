# ========================================
# Environment variables / secrets
# ========================================
.env
.env.*
!.env.example

# ========================================
# Frontend - Node / Next.js
# ========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
frontend/.vercel/
frontend/coverage/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Frontend logs
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*

# ========================================
# Backend - Python / Django
# ========================================
backend/__pycache__/
backend/**/*.py[cod]
backend/*$py.class

# Python virtual environments
backend/venv/
backend/.venv/
backend/env/
backend/ENV/

# Django
backend/db.sqlite3
backend/db.sqlite3-journal
backend/staticfiles/
backend/media/

# Python tooling
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/

# ========================================
# Django migrations
# ========================================
# DO NOT ignore migrations.
# They should be committed to Git.

